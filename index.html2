<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TikTok Treasure Box Timer</title>
    <style>
        body {
            background-color: #ffffff;
            color: #000000;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            text-align: center;
            margin: 0;
            padding: 10px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            box-sizing: border-box;
        }
        .container {
            background: #ffffff;
            padding: 15px 20px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
            width: 300px;
            border: 1px solid #eaeaea;
        }
        .username {
            color: #28a745;
            font-size: 19px;
            font-weight: bold;
            margin-bottom: 4px;
        }
        .stats {
            font-size: 13px;
            color: #666;
            margin-bottom: 12px;
        }
        #timer {
            font-size: 55px;
            font-weight: 800;
            color: #000;
            margin: 5px 0;
            letter-spacing: -1px;
        }
        #sub-timer {
            font-size: 17px;
            color: #555;
            margin-bottom: 15px;
            font-weight: 600;
        }
        .controls {
            margin-bottom: 15px;
            display: flex;
            gap: 5px;
            justify-content: center;
        }
        .controls input {
            width: 70px;
            padding: 5px;
            text-align: center;
            font-size: 14px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }
        .controls button {
            padding: 5px 10px;
            font-size: 13px;
            background: #28a745;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        .btn {
            background: none;
            border: none;
            color: #0056b3;
            font-size: 14px;
            font-weight: bold;
            cursor: pointer;
            text-decoration: underline;
            padding: 5px;
        }
        .color-box {
            width: 35px;
            height: 22px;
            background-color: #dc3545;
            margin: 8px auto 0 auto;
            border-radius: 4px;
            border: 1px solid #ccc;
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- Parametrlərdən time_id oxumaq dəstəyi -->
        <div class="username" id="displayUser">p*ostoy_sport*k2</div>
        <div class="stats">100/5 - 🏳️ - 👀 89</div>
        
        <div id="timer">00.0</div>
        <div id="sub-timer">00:00:00</div>

        <!-- Saniyəni əllə və ya test üçün tənzimləmək üçün panel -->
        <div class="controls">
            <input type="number" id="secInput" value="70" placeholder="San">
            <button onclick="setTimer()">Başlat</button>
        </div>

        <button class="btn" onclick="changeBackground()">Đổi màu nền</button>
        <div class="color-box" id="colorBox"></div>
    </div>

    <script>
        // URL-dən time_id parametrini oxumaq (məsələn: ?time_id=12345)
        const urlParams = new URLSearchParams(window.location.search);
        const timeId = urlParams.get('time_id');
        if (timeId) {
            document.querySelector('.stats').innerText = `ID: ${timeId} - 🏳️ - 👀 Live`;
        }

        let totalSeconds = 70;
        let interval = null;
        const subTimerEl = document.getElementById("sub-timer");
        const mainTimerEl = document.getElementById("timer");
        const secInput = document.getElementById("secInput");

        function startCountdown() {
            if (interval) clearInterval(interval);
            
            updateDisplay();
            interval = setInterval(() => {
                if (totalSeconds > 0) {
                    totalSeconds--;
                    updateDisplay();
                } else {
                    clearInterval(interval);
                    mainTimerEl.textContent = "00.0";
                    subTimerEl.textContent = "00:00:00";
                }
            }, 1000);
        }

        function updateDisplay() {
            let mins = String(Math.floor(totalSeconds / 60)).padStart(2, '0');
            let secs = String(totalSeconds % 60).padStart(2, '0');
            subTimerEl.textContent = `00:${mins}:${secs}`;
            
            let wholeSec = Math.floor(totalSeconds);
            mainTimerEl.textContent = `0${Math.floor(wholeSec/10)}.${wholeSec%10}`;
        }

        function setTimer() {
            let val = parseInt(secInput.value);
            if (!isNaN(val) && val > 0) {
                totalSeconds = val;
                startCountdown();
            }
        }

        function changeBackground() {
            const colors = ['#ffffff', '#f8d7da', '#d4edda', '#d1ecf1', '#fff3cd', '#e2e3e5'];
            const randomColor = colors[Math.floor(Math.random() * colors.length)];
            document.body.style.backgroundColor = randomColor;
            document.querySelector('.container').style.backgroundColor = randomColor;
        }

        // Avtomatik başlanğıc
        startCountdown();
    </script>
</body>
          </html>
          
